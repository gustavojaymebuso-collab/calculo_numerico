        "import numpy as np\n",
        "\n",
        "def eliminacao_gauss(A, b):\n",
        "    \"\"\"\n",
        "    Resolve o sistema Ax = b usando Eliminação de Gauss sem pivotamento.\n",
        "    \"\"\"\n",
        "    n = len(b)\n",
        "    # Converte para float para evitar problemas de divisão inteira\n",
        "    A = A.astype(float)\n",
        "    b = b.astype(float)\n",
        "\n",
        "    # 1. Formar a matriz aumentada\n",
        "    Ab = np.column_stack((A, b))\n",
        "\n",
        "    # 2. Eliminar os elementos abaixo dos pivôs (Eliminação Progressiva)\n",
        "    for i in range(n):\n",
        "        for j in range(i + 1, n):\n",
        "            fator = Ab[j, i] / Ab[i, i]\n",
        "            Ab[j, i:] = Ab[j, i:] - fator * Ab[i, i:]\n",
        "\n",
        "    # 3. Aplicar substituição regressiva\n",
        "    x = np.zeros(n)\n",
        "    for i in range(n - 1, -1, -1):\n",
        "        soma = np.dot(Ab[i, i+1:n], x[i+1:n])\n",
        "        x[i] = (Ab[i, n] - soma) / Ab[i, i]\n",
        "\n",
        "    return x, Ab\n",
        "\n",
        "# --- Teste com o sistema do Exercício 2 ---\n",
        "\n",
        "# Matriz dos coeficientes A\n",
        "A = np.array([\n",
        "    [2, 1, -1],\n",
        "    [-3, -1, 2],\n",
        "    [-2, 1, 2]\n",
        "])\n",
        "\n",
        "# Vetor independente b\n",
        "b = np.array([8, -11, -3])\n",
        "\n",
        "# Executando o algoritmo implementado\n",
        "solucao_propria, matriz_aumentada_final = eliminacao_gauss(A, b)\n",
        "\n",
        "# Executando a solução do numpy para comparação\n",
        "solucao_numpy = np.linalg.solve(A, b)\n",
        "\n",
        "# Exibindo os resultados\n",
        "print(\"Matriz Aumentada Final (após eliminação):\")\n",
        "print(matriz_aumentada_final)\n",
        "print(\"\\nSolução pelo algoritmo de Gauss sem pivotamento:\")\n",
        "print(f\"x = {solucao_propria[0]:.4f}, y = {solucao_propria[1]:.4f}, z = {solucao_propria[2]:.4f}\")\n",
        "print(\"\\nSolução pelo numpy.linalg.solve:\")\n",
        "print(f\"x = {solucao_numpy[0]:.4f}, y = {solucao_numpy[1]:.4f}, z = {solucao_numpy[2]:.4f}\")"
