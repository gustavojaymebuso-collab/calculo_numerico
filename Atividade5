        "import numpy as np\n",
        "\n",
        "# Definindo a matriz A e o vetor b\n",
        "A = np.array([\n",
        "    [4, -1, 0],\n",
        "    [-1, 4, -1],\n",
        "    [0, -1, 3]\n",
        "])\n",
        "b = np.array([15, 10, 10])\n",
        "\n",
        "# Resolvendo o sistema\n",
        "T = np.linalg.solve(A, b)\n",
